# ──────────────────────────────────────────────────────────────────────────────
# automell  –  Configuration
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8082

# ─── Model Routing ────────────────────────────────────────────────────────────
# Format: <provider_prefix>/<model_name>
# Provider prefixes: nvidia_nim, open_router, deepseek, lmstudio, llamacpp, ollama

MODEL_OPUS=nvidia_nim/z-ai/glm4.7
MODEL_SONNET=open_router/minimax/minimax-m2.5:free
MODEL_HAIKU=open_router/openai/gpt-oss-120b:free
MODEL=nvidia_nim/z-ai/glm4.7

# ─── API Keys ─────────────────────────────────────────────────────────────────
NVIDIA_NIM_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# ─── Local Provider Base URLs ─────────────────────────────────────────────────
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LLAMACPP_BASE_URL=http://localhost:8080/v1
OLLAMA_BASE_URL=http://localhost:11434

# ─── Per-Provider HTTP/SOCKS5 Proxy (optional) ────────────────────────────────
# Format: http://user:pass@host:port  or  socks5://host:port
NVIDIA_NIM_PROXY=
OPENROUTER_PROXY=
LMSTUDIO_PROXY=
LLAMACPP_PROXY=
OLLAMA_PROXY=

# ─── Thinking Output ──────────────────────────────────────────────────────────
# ENABLE_MODEL_THINKING is the global default; per-model vars override it.
# Leave per-model vars empty to inherit the global value.
ENABLE_MODEL_THINKING=true
ENABLE_OPUS_THINKING=
ENABLE_SONNET_THINKING=
ENABLE_HAIKU_THINKING=

# ─── Auth ─────────────────────────────────────────────────────────────────────
# If set, clients must provide this token via x-api-key or Authorization header.
# Leave empty to allow unauthenticated access (only do this on localhost).
ANTHROPIC_AUTH_TOKEN=automell

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_RPM=60
RATE_LIMIT_RPD=1000
CONCURRENCY_LIMIT=5

# ─── HTTP Client Timeouts (seconds) ───────────────────────────────────────────
HTTP_READ_TIMEOUT=300    # max time to wait for a full provider response (streaming)
HTTP_WRITE_TIMEOUT=10    # max time to write the request body to the provider
HTTP_CONNECT_TIMEOUT=10  # dial + TLS handshake timeout
HTTP_RESPONSE_HEADER_TIMEOUT=120  # max wait for first response header byte (increase for slow providers like NIM)

# ─── Diagnostics ──────────────────────────────────────────────────────────────
# WARNING: enabling these may log sensitive prompt/response data.
LOG_RAW_API_PAYLOADS=false   # log outbound request and inbound response bodies
LOG_RAW_SSE_EVENTS=false     # log each raw SSE data line from the provider

# ─── Discord Bot (optional) ──────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# ─── Telegram Bot (optional) ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Web Server Tools ─────────────────────────────────────────────────────────
# Allow the LLM to call web_fetch and web_search tools.
ENABLE_WEB_SERVER_TOOLS=false
# Comma-separated list of allowed URL schemes (default: http,https)
WEB_FETCH_ALLOWED_SCHEMES=http,https
# Allow fetching private/internal network addresses (disable in production)
WEB_FETCH_ALLOW_PRIVATE_NETWORKS=false

# ─── Voice Note Transcription ─────────────────────────────────────────────────
# Transcribe voice messages sent to Discord/Telegram bots.
VOICE_NOTE_ENABLED=false
# Transcription backend: cpu | cuda | nvidia_nim
WHISPER_DEVICE=cpu
# Whisper model size (for local): tiny | base | small | medium | large
WHISPER_MODEL=base
# Hugging Face token (if required by model)
HF_TOKEN=

# ─── Startup Smoke Tests ──────────────────────────────────────────────────────
# Send a minimal request to each configured provider on startup to verify connectivity.
SMOKE_TEST_ON_STARTUP=false

# ─── Messaging Session ────────────────────────────────────────────────────────
# Idle timeout (seconds) before a bot session is automatically marked done.
MESSAGING_SESSION_TIMEOUT=300

# ─── Example: Mix providers ───────────────────────────────────────────────────
# MODEL_OPUS=nvidia_nim/meta/llama-3.1-405b-instruct
# MODEL_SONNET=open_router/anthropic/claude-3.5-sonnet
# MODEL_HAIKU=deepseek/deepseek-chat
# MODEL=nvidia_nim/meta/llama-3.1-70b-instruct

# ─── Example: OpenRouter only ─────────────────────────────────────────────────
# MODEL_OPUS=open_router/anthropic/claude-3.5-sonnet
# MODEL_SONNET=open_router/openai/gpt-4o
# MODEL_HAIKU=open_router/meta-llama/llama-3.1-8b-instruct
# MODEL=open_router/anthropic/claude-3.5-sonnet

# ─── Example: Fully local (LM Studio) ────────────────────────────────────────
# MODEL_OPUS=lmstudio/local-model
# MODEL_SONNET=lmstudio/local-model
# MODEL_HAIKU=lmstudio/local-model
# MODEL=lmstudio/local-model

# ─── Example: Ollama ──────────────────────────────────────────────────────────
# OLLAMA_BASE_URL=http://localhost:11434
# MODEL=ollama/llama3.2
